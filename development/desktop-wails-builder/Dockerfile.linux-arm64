# syntax=docker/dockerfile:1
# Isolated native ARM64 desktop GUI Wails builder.
# Build this with Docker/Podman --platform linux/arm64 so linux-arm64 Wails CGO
# builds use target-native GTK/WebKit headers and libraries instead of mixing
# x86_64 pkg-config output into an aarch64 cross compile. Do not install these
# tools on the Hermes host.
FROM --platform=linux/arm64 golang:1.25-bookworm

ARG DEBIAN_FRONTEND=noninteractive
ARG WAILS_VERSION=v2.10.2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        nodejs \
        npm \
        pkg-config \
        build-essential \
        libgtk-3-dev \
        libwebkit2gtk-4.1-dev \
        libayatana-appindicator3-dev \
        librsvg2-dev \
        zip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV GOPATH=/go
ENV PATH=/go/bin:/usr/local/go/bin:$PATH
ENV FSE_DESKTOP_WAILS_TARGETS="linux/arm64"
ENV FSE_DESKTOP_WAILS_NATIVE_LINUX_ARM64=1

# Keep the pinned command visible for structural release-contract tests:
# github.com/wailsapp/wails/v2/cmd/wails@v2.10.2
RUN go install github.com/wailsapp/wails/v2/cmd/wails@${WAILS_VERSION}

WORKDIR /tmp/work
CMD ["wails", "doctor"]
