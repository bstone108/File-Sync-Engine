# syntax=docker/dockerfile:1
# Legacy WebKitGTK 4.0 Linux desktop GUI Wails builder.
# Use this only for producing compatibility artifacts for older distributions
# that still ship the webkit2gtk-4.0 ABI/runtime packages.
FROM node:22-bookworm AS node-runtime

FROM golang:1.25-bookworm

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
# COPY dereferences npm/npx symlinks; recreate their original paths so their
# relative imports resolve from the Node 22 module tree rather than /usr/local/bin.
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

LABEL org.filesyncengine.desktop.wails.go-version="1.25.7" \
      org.filesyncengine.desktop.wails.node-major="22"

ARG DEBIAN_FRONTEND=noninteractive
ARG WAILS_VERSION=v2.10.2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        pkg-config \
        build-essential \
        libgtk-3-dev \
        libwebkit2gtk-4.0-dev \
        libayatana-appindicator3-dev \
        librsvg2-dev \
        mingw-w64 \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        zip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV GOPATH=/go
ENV PATH=/go/bin:/usr/local/go/bin:$PATH
ENV FSE_DESKTOP_LINUX_WEBKIT_API=4.0
ENV FSE_DESKTOP_WAILS_TARGETS="linux/amd64 linux/arm64"

# Keep the pinned command visible for structural release-contract tests:
# github.com/wailsapp/wails/v2/cmd/wails@v2.10.2
RUN go install github.com/wailsapp/wails/v2/cmd/wails@${WAILS_VERSION}

RUN pkg-config --exists gtk+-3.0 webkit2gtk-4.0

WORKDIR /tmp/work
CMD ["wails", "doctor"]
