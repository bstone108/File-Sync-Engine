# Repository metadata and CI configuration are not runtime build inputs.
.git/
.github/

# Desktop, mobile, and optional web GUI sources are deliberately outside the
# headless daemon image build context.
desktop-gui/
mobile-gui/
web-gui/

# Documentation, local builder recipes, and generated release outputs are not
# required to compile ./cmd/fse.
docs/
development/
build/
builds/
tmp/
*.log
